/* ============================================
   CAREER CONSULTING PORTFOLIO
   Color Palette: Higo Creative Style
   Deep Navy + Vibrant Coral + Teal + Clean Whites
   ============================================ */

:root {
    /* Primary Colors */
    --navy-primary: #1a2640;
    --navy-dark: #0f1620;
    --navy-light: #2a3f5f;
    
    /* Accent Colors */
    --coral-vibrant: #ff6b54;
    --coral-hover: #ff5540;
    --teal-accent: #1eae98;
    --teal-light: #2dd4bf;
    
    /* Neutral Colors */
    --white: #ffffff;
    --cream-light: #f8f9fc;
    --gray-light: #e8ecf1;
    --gray-medium: #999999;
    --gray-dark: #4a5568;
    --charcoal: #1a1a1a;
    
    /* Typography Colors */
    --text-primary: #1a2640;
    --text-secondary: #4a5568;
    --text-light: #999999;
}

/* ============================================
   GLOBAL STYLES
   ============================================ */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: 'Inter', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    line-height: 1.6;
    color: var(--text-primary);
    background-color: var(--white);
}

a {
    text-decoration: none;
    color: inherit;
    transition: all 0.3s ease;
}

a:hover {
    color: var(--coral-vibrant);
}

h1, h2, h3, h4, h5, h6 {
    color: var(--text-primary);
    font-weight: 700;
}

p {
    color: var(--text-secondary);
}

/* ============================================
   NAVIGATION BAR
   ============================================ */

.navbar {
    background-color: var(--white);
    box-shadow: 0 2px 8px rgba(26, 38, 64, 0.08);
    padding: 1rem 0;
    position: sticky;
    top: 0;
    z-index: 100;
    transition: all 0.3s ease;
}

.navbar.scrolled {
    box-shadow: 0 4px 16px rgba(26, 38, 64, 0.12);
    padding: 0.8rem 0;
}

.nav-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
}

.nav-logo {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
}

.nav-logo h1 {
    font-size: 1.5rem;
    color: var(--navy-primary);
    margin: 0;
}

.tagline {
    color: var(--coral-vibrant);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin: 0;
}

.nav-menu {
    display: flex;
    list-style: none;
    gap: 2.5rem;
    flex-wrap: wrap;
}

.nav-item a {
    color: var(--text-primary);
    font-weight: 600;
    font-size: 0.95rem;
    position: relative;
    transition: color 0.3s ease;
}

.nav-item a:hover,
.nav-item a.active {
    color: var(--coral-vibrant);
}

.nav-item a::after {
    content: '';
    position: absolute;
    bottom: -8px;
    left: 0;
    width: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--coral-vibrant), var(--teal-accent));
    transition: width 0.3s ease;
}

.nav-item a:hover::after,
.nav-item a.active::after {
    width: 100%;
}

/* Hamburger Menu */
.hamburger {
    display: none;
    flex-direction: column;
    gap: 6px;
    cursor: pointer;
}

.hamburger span {
    width: 25px;
    height: 3px;
    background-color: var(--navy-primary);
    border-radius: 2px;
    transition: all 0.3s ease;
}

/* ============================================
   MAIN CONTAINER & SECTIONS
   ============================================ */

.container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2rem;
}

section {
    scroll-margin-top: 80px;
}

/* ============================================
   HERO SECTION
   ============================================ */

.hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
    padding: 6rem 2rem;
    min-height: 700px;
}

.hero-content h2 {
    color: var(--navy-primary);
    font-size: 3.5rem;
    line-height: 1.2;
    margin-bottom: 1.5rem;
    font-weight: 800;
}

.hero-content h2 .highlight {
    background: linear-gradient(135deg, var(--coral-vibrant), var(--teal-accent));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.hero-text {
    color: var(--text-secondary);
    font-size: 1.25rem;
    line-height: 1.8;
    margin-bottom: 2rem;
}

.hero-buttons {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
}

.hero-image {
    position: relative;
}

.hero-image img {
    width: 100%;
    border-radius: 12px;
    box-shadow: 0 20px 40px rgba(26, 38, 64, 0.15);
    transition: transform 0.3s ease;
}

.hero-image:hover img {
    transform: scale(1.02);
}

/* ============================================
   BUTTONS
   ============================================ */

.btn {
    display: inline-block;
    padding: 0.9rem 1.8rem;
    border-radius: 6px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.3s ease;
    text-align: center;
    font-size: 0.95rem;
    border: none;
}

.btn-primary {
    background: linear-gradient(135deg, var(--coral-vibrant), #ff8066);
    color: var(--white);
    box-shadow: 0 4px 15px rgba(255, 107, 84, 0.3);
}

.btn-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 25px rgba(255, 107, 84, 0.4);
    background: linear-gradient(135deg, var(--coral-hover), #ff6f4f);
}

.btn-secondary {
    background-color: transparent;
    color: var(--navy-primary);
    border: 2px solid var(--navy-primary);
}

.btn-secondary:hover {
    background-color: var(--navy-primary);
    color: var(--white);
}

.btn-outline-coral {
    background-color: transparent;
    color: var(--coral-vibrant);
    border: 2px solid var(--coral-vibrant);
}

.btn-outline-coral:hover {
    background-color: var(--coral-vibrant);
    color: var(--white);
}

/* ============================================
   SECTION HEADERS
   ============================================ */

.section-header {
    text-align: center;
    margin-bottom: 4rem;
}

.section-header h2 {
    font-size: 2.8rem;
    color: var(--navy-primary);
    margin-bottom: 1rem;
}

.section-header p {
    font-size: 1.1rem;
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto;
}

.section-tag {
    display: inline-block;
    background-color: var(--cream-light);
    color: var(--coral-vibrant);
    padding: 0.5rem 1rem;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 1rem;
}

/* ============================================
   ABOUT ME SECTION
   ============================================ */

.about-section {
    background-color: var(--cream-light);
    padding: 6rem 2rem;
}

.about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
}

.about-image img {
    width: 100%;
    border-radius: 12px;
    box-shadow: 0 20px 40px rgba(26, 38, 64, 0.15);
}

.about-content h3 {
    font-size: 2.2rem;
    margin-bottom: 1.5rem;
    color: var(--navy-primary);
}

.about-content p {
    font-size: 1.05rem;
    line-height: 1.9;
    margin-bottom: 1.5rem;
    color: var(--text-secondary);
}

.values-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: 2.5rem;
}

.value-card {
    background-color: var(--white);
    padding: 1.5rem;
    border-radius: 8px;
    text-align: center;
    transition: all 0.3s ease;
    border-top: 3px solid transparent;
}

.value-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(26, 38, 64, 0.1);
}

.value-card:nth-child(1) {
    border-top-color: var(--coral-vibrant);
}

.value-card:nth-child(2) {
    border-top-color: var(--teal-accent);
}

.value-card:nth-child(3) {
    border-top-color: var(--coral-vibrant);
}

.value-card h4 {
    color: var(--navy-primary);
    margin-bottom: 0.75rem;
    font-size: 1.1rem;
}

.value-card p {
    color: var(--text-light);
    font-size: 0.95rem;
}

/* ============================================
   SERVICE CARDS SECTION
   ============================================ */

.services-section {
    padding: 6rem 2rem;
    background-color: var(--white);
}

.cards-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
}

.service-card {
    background-color: var(--cream-light);
    border-radius: 12px;
    overflow: hidden;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid var(--gray-light);
}

.service-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(255, 107, 84, 0.15);
    border-color: var(--coral-vibrant);
}

.service-card-header {
    background: linear-gradient(135deg, var(--navy-primary), var(--navy-light));
    padding: 2rem;
    text-align: center;
    color: var(--white);
}

.service-card-header i {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    background: linear-gradient(135deg, var(--coral-vibrant), var(--teal-accent));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.service-card-header h3 {
    color: var(--white);
    font-size: 1.5rem;
    margin: 0;
}

.service-card-content {
    padding: 2rem;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
}

.service-card-content p {
    font-size: 0.95rem;
    margin-bottom: 1.5rem;
    flex-grow: 1;
}

.service-features {
    list-style: none;
    margin: 1rem 0;
}

.service-features li {
    padding: 0.5rem 0;
    color: var(--text-secondary);
    font-size: 0.9rem;
    padding-left: 1.5rem;
    position: relative;
}

.service-features li:before {
    content: "→";
    position: absolute;
    left: 0;
    color: var(--coral-vibrant);
    font-weight: bold;
}

/* ============================================
   RESOURCES SECTION
   ============================================ */

.resources-section {
    background-color: var(--cream-light);
    padding: 6rem 2rem;
}

.resources-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
}

.resource-card {
    background-color: var(--white);
    padding: 2rem;
    border-radius: 12px;
    box-shadow: 0 4px 12px rgba(26, 38, 64, 0.08);
    transition: all 0.3s ease;
    border-left: 4px solid var(--coral-vibrant);
}

.resource-card:nth-child(even) {
    border-left-color: var(--teal-accent);
}

.resource-card:hover {
    transform: translateX(5px);
    box-shadow: 0 12px 30px rgba(26, 38, 64, 0.15);
}

.resource-card i {
    font-size: 2.5rem;
    color: var(--coral-vibrant);
    margin-bottom: 1rem;
    display: block;
}

.resource-card:nth-child(even) i {
    color: var(--teal-accent);
}

.resource-card h3 {
    font-size: 1.3rem;
    margin-bottom: 0.75rem;
    color: var(--navy-primary);
}

.resource-card p {
    color: var(--text-light);
    font-size: 0.9rem;
    margin-bottom: 1.5rem;
}

.resource-link {
    display: inline-block;
    color: var(--coral-vibrant);
    font-weight: 700;
    text-decoration: none;
    transition: all 0.3s ease;
}

.resource-link:hover {
    color: var(--coral-hover);
    transform: translateX(3px);
}

/* ============================================
   CONTACT SECTION
   ============================================ */

.contact-section {
    padding: 6rem 2rem;
    background-color: var(--white);
}

.contact-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-bottom: 4rem;
}

.contact-card {
    background: linear-gradient(135deg, var(--cream-light), var(--white));
    padding: 2rem;
    border-radius: 12px;
    text-align: center;
    border: 1px solid var(--gray-light);
    transition: all 0.3s ease;
}

.contact-card:hover {
    transform: translateY(-5px);
    border-color: var(--coral-vibrant);
    box-shadow: 0 10px 30px rgba(255, 107, 84, 0.1);
}

.contact-card i {
    font-size: 2.5rem;
    background: linear-gradient(135deg, var(--coral-vibrant), var(--teal-accent));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 1rem;
}

.contact-card h3 {
    font-size: 1.2rem;
    margin-bottom: 0.8rem;
}

.contact-card a {
    color: var(--coral-vibrant);
    font-weight: 700;
    text-decoration: none;
}

.contact-card a:hover {
    text-decoration: underline;
}

.contact-form-wrapper {
    background-color: var(--cream-light);
    padding: 3rem;
    border-radius: 12px;
    border: 1px solid var(--gray-light);
}

.contact-form-wrapper h3 {
    font-size: 1.8rem;
    margin-bottom: 0.5rem;
    color: var(--navy-primary);
}

.contact-form-wrapper > p {
    margin-bottom: 2rem;
    color: var(--text-secondary);
}

#contactForm {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
}

#contactForm input,
#contactForm select,
#contactForm textarea {
    padding: 0.9rem;
    border: 1px solid var(--gray-light);
    border-radius: 6px;
    font-size: 0.95rem;
    font-family: inherit;
    transition: all 0.3s ease;
    background-color: var(--white);
    color: var(--text-primary);
}

#contactForm input::placeholder,
#contactForm select::placeholder,
#contactForm textarea::placeholder {
    color: var(--gray-medium);
}

#contactForm input:focus,
#contactForm select:focus,
#contactForm textarea:focus {
    outline: none;
    border-color: var(--coral-vibrant);
    box-shadow: 0 0 0 4px rgba(255, 107, 84, 0.1);
    background-color: var(--white);
}

/* ============================================
   FOOTER
   ============================================ */

.footer {
    background-color: var(--navy-primary);
    color: var(--white);
    padding: 4rem 2rem 2rem;
}

.footer-content {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 3rem;
    margin-bottom: 3rem;
}

.footer-section h4 {
    color: var(--coral-vibrant);
    margin-bottom: 1.5rem;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.footer-section ul {
    list-style: none;
}

.footer-section ul li {
    margin-bottom: 0.8rem;
}

.footer-section a {
    color: rgba(255, 255, 255, 0.8);
    transition: color 0.3s ease;
    font-size: 0.95rem;
}

.footer-section a:hover {
    color: var(--coral-vibrant);
}

.footer-bottom {
    text-align: center;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.9rem;
}

/* ============================================
   RESPONSIVE DESIGN
   ============================================ */

@media (max-width: 1024px) {
    .hero {
        grid-template-columns: 1fr;
        gap: 2rem;
        padding: 4rem 2rem;
        min-height: auto;
    }

    .hero-content h2 {
        font-size: 2.5rem;
    }

    .about-grid {
        grid-template-columns: 1fr;
        gap: 2rem;
    }

    .cards-grid,
    .resources-grid,
    .contact-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 1.5rem;
    }

    .values-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 768px) {
    .nav-menu {
        gap: 1.5rem;
    }

    .nav-item a {
        font-size: 0.85rem;
    }

    .hero {
        padding: 3rem 1.5rem;
    }

    .hero-content h2 {
        font-size: 2rem;
    }

    .hero-text {
        font-size: 1rem;
    }

    .section-header h2 {
        font-size: 2rem;
    }

    .cards-grid,
    .resources-grid,
    .contact-grid,
    .values-grid {
        grid-template-columns: 1fr;
    }

    .container {
        padding: 0 1.5rem;
    }

    .about-section,
    .services-section,
    .resources-section,
    .contact-section {
        padding: 4rem 1.5rem;
    }

    .hero-buttons {
        flex-direction: column;
    }

    .btn {
        width: 100%;
    }
}

@media (max-width: 480px) {
    .nav-logo h1 {
        font-size: 1.2rem;
    }

    .tagline {
        font-size: 0.7rem;
    }

    .hero-content h2 {
        font-size: 1.5rem;
    }

    .section-header h2 {
        font-size: 1.6rem;
    }

    .service-card-content,
    .resource-card,
    .contact-card {
        padding: 1.5rem;
    }

    .contact-form-wrapper {
        padding: 1.5rem;
    }

    #contactForm {
        gap: 1rem;
    }
}

/* ============================================
   ANIMATIONS & TRANSITIONS
   ============================================ */

@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.fade-in-up {
    animation: fadeInUp 0.6s ease-out;
}

/* Smooth scrolling for all sections */
section {
    transition: background-color 0.3s ease;
}
